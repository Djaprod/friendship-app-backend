# Copy to .env on your hosting machine. Do not commit real secrets.
ARTII_DOMAIN=replace-with-your-domain.example
PUBLIC_ORIGIN=https://replace-with-your-domain.example
AUTH_ISSUER=https://replace-with-your-tenant.auth0.com/
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Set each connection name only after enabling and testing it in Auth0.
AUTH_GOOGLE_CONNECTION=
AUTH_FACEBOOK_CONNECTION=
AUTH_APPLE_CONNECTION=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Leave blank to keep purchases disabled. Configure only after Play Console setup.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_PACKAGE=com.artii.app
GOOGLE_PLAY_TRIAL_OFFER=trial-3days

# Managed database: use a direct or SESSION pooler connection, never transaction pooling.
# Keep this secret on the server. URI-encode special characters in its password.
DATABASE_URL=
# Optional raw database password; overrides the URL password. Do not URI-encode or wrap in quotes in Render.
DATABASE_PASSWORD=
# Certificate verification is always enabled in production. Add provider CA if needed.
DATABASE_CA_FILE=
DATA_DIR=/app/server/data
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
# Enable only behind a trusted proxy that appends the real client IP.
TRUST_PROXY=0
